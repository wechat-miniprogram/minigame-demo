{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "sourceMap": false,
    "strict": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "./node_modules/minigame-api-typings/types"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "rootDir": "./minigame",
    "outDir": "./dist"
  },
  "include": ["minigame/**/*.ts"],
  "exclude": [
    "node_modules",
    "minigame/js/vendor",
    "dist"
  ]
}